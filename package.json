{
  "name": "lumaglass",
  "version": "2.9.0",
  "private": true,
  "description": "Native home and TV controls for rooted LG webOS TVs.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "cargo run --locked --",
    "build": "sh tools/webos/build-webos.sh",
    "package": "pnpm assets && pnpm build && node tools/release/package.mjs && node tools/release/repository.mjs",
    "deploy": "pnpm run package && node tools/webos/deploy.mjs",
    "test": "pnpm test:photo-auth && pnpm test:release && pnpm test:home && pnpm test:icons && pnpm test:apps && pnpm test:controls && pnpm test:screensaver && cargo test --locked --workspace --all-features",
    "test:apps": "node --test tests/app-management.test.mjs tests/system-apps.test.mjs",
    "test:release": "node --test tests/release.test.mjs",
    "test:home": "node --test tests/home-splash.test.mjs tests/home-executable.test.mjs tests/home-mounts.test.mjs tests/sync-splash.test.mjs",
    "test:icons": "node --test tests/read-app-icon.test.mjs tests/brand-assets.test.mjs",
    "test:smoke": "node tests/smoke.mjs && node tests/brands-smoke.mjs && node tests/weather-smoke.mjs && node tests/translations-smoke.mjs && pnpm test:display && node tests/system-apps-smoke.mjs && node tests/screensaver-smoke.mjs && node tests/immich-smoke.mjs && node tests/design-smoke.mjs && node tests/cloud-smoke.mjs",
    "test:display": "node tests/display-watchdog-smoke.mjs",
    "test:brands": "node tests/brands-smoke.mjs",
    "check": "pnpm version:check && pnpm lint && cargo clippy --locked --workspace --all-targets --all-features -- -D warnings",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "cargo fmt --all && oxfmt --write .",
    "format:check": "cargo fmt --all -- --check && oxfmt --check .",
    "assets": "node tools/assets/assets.mjs",
    "screenshots": "pnpm assets && node tools/dev/screenshots.mjs",
    "assets:vector": "node tools/assets/vector-assets.mjs",
    "assets:brands": "node tools/assets/brand-assets.mjs",
    "assets:fonts": "node tools/assets/font-assets.mjs",
    "runtime": "node tools/webos/webos-runtime.mjs",
    "sdk": "node tools/webos/setup-webos-sdk.mjs",
    "test:weather": "node tests/weather-smoke.mjs",
    "test:translations": "node tests/translations-smoke.mjs",
    "changeset": "changeset",
    "version:release": "changeset version && pnpm version:sync && oxfmt --write CHANGELOG.md",
    "version:sync": "node tools/release/sync-version.mjs",
    "version:check": "node tools/release/sync-version.mjs --check",
    "test:controls": "node --test tests/tv-controls.test.mjs tests/blocker.test.mjs",
    "test:screensaver": "node --test tests/screensaver.test.mjs",
    "test:photo-auth": "node --test tests/google-auth.test.mjs tests/google-photos-export.test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@webos-tools/cli": "3.2.6",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "sharp": "0.35.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/federi95/lumaglass.git"
  }
}
